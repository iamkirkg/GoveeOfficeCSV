Attribute VB_Name = "Colors"
Option Explicit

' ---------------------------------------------------------------
' English-named color constants.
' Each is a Long in &HBBGGRR order, same as RGB(r, g, b) returns.
' ---------------------------------------------------------------
Public Const clrBlack       As Long = 0
Public Const clrWhite       As Long = 16777215
Public Const clrRed         As Long = 255
Public Const clrGreen       As Long = 32768
Public Const clrBlue        As Long = 16711680
Public Const clrYellow      As Long = 65535
Public Const clrOrange      As Long = 42495
Public Const clrPurple      As Long = 8388736
Public Const clrCyan        As Long = 16776960
Public Const clrMagenta     As Long = 16711935
Public Const clrGray        As Long = 8421504
Public Const clrDarkGray    As Long = 4210752
Public Const clrLightGray   As Long = 12632256
' A few project-specific extras
Public Const clrTeal        As Long = 8421376
Public Const clrOlive       As Long = 32896
Public Const clrBrown       As Long = 13209
Public Const clrPink        As Long = 12695295
Public Const clrNavy        As Long = 8388608
